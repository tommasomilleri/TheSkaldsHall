# ==============================================================================
#  THE SKALD'S HALL — .gitignore
#  Regola d'oro: le negazioni (!) devono stare DOPO l'esclusione che annullano.
# ==============================================================================

# === Cartelle generate da Unreal Engine (mai committare) ===
**/Binaries/
**/Build/
**/DerivedDataCache/
**/Intermediate/
**/Saved/
**/Platforms/*/Intermediate/
**/Plugins/*/Intermediate/
**/Plugins/*/Binaries/
*.target
*.modules

# === Visual Studio / Rider / compilatori ===
.vs/
.idea/
*.vsconfig
*.sln
*.slnx
*.suo
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.VC.db
*.VC.opendb
*.user
*.pdb

# === Cache, log e temporanei ===
*.tmp
*.log
*.bak
*.orig
*.autosave

# === Backup automatici dell'editor ===
*.uasset.bak
*.umap.bak
**/__ExternalActors__*/**/*.bak
**/__ExternalObjects__*/**/*.bak

# === Sistema operativo ===
.DS_Store
Thumbs.db
desktop.ini

# ==============================================================================
#  CONTENUTI PESANTI DEL PROGETTO
# ==============================================================================

# Reference, SFX grezzi
Materiale/

# Asset enormi scaricati (MetaHuman, Fab)
**/Content/MetaHumans/
**/Content/Fab/

# Scena del banchetto
**/Content/Scene_Banquet/
**/Content/__ExternalActors__/Scene_Banquet/
**/Content/__ExternalObjects__/Scene_Banquet/

# Media pesanti ovunque
*.wav
*.mp3
*.mp4
*.pdf
*.zip
*.rar
*.7z

# ECCEZIONE: voci TTS finali usate da UE (piccole, vanno versionate)
!**/Content/Audio/Voices/**/*.wav

# ==============================================================================
#  TOOL TTS (cartella TTS/ nella root del repo)
#  Si committano SOLO script, csv, requirements.txt e README.
# ==============================================================================
TTS/venv/
TTS/.venv/
TTS/env/
TTS/raw/
TTS/out/
TTS/final/
TTS/**/__pycache__/
TTS/**/*.pyc

# Modelli ML (si scaricano, non si committano)
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.bin

# Ambienti Python ovunque nel repo
**/venv/
**/.venv/
**/__pycache__/
*.pyc

# ==============================================================================
#  NOTE
#  - Plugins/OVRLipSync/OfflineModel/ovrlipsync_offline_model.pb è GIÀ tracciato:
#    non viene toccato da queste regole.
#  - I .uasset/.umap si committano (meglio con Git LFS, vedi .gitattributes).
# ==============================================================================